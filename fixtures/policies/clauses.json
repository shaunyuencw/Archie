{
  "version": "1.0",
  "label": "SYNTHETIC — DEMONSTRATION ONLY",
  "clauses": [
    {
      "id": "DEMO-ZON-01",
      "tags": [
        "zone",
        "deployment"
      ],
      "text": "Every in-scope networked deployment has a declared zone.",
      "exceptions": "Explicit external system references are exempt.",
      "implementation": "implemented",
      "version": "1.0",
      "applicability": [
        "zone",
        "deployment"
      ]
    },
    {
      "id": "DEMO-ADM-01",
      "tags": [
        "management",
        "client"
      ],
      "text": "Client management access uses the declared management interface and never a direct processing service path.",
      "exceptions": "None in this demonstration.",
      "implementation": "implemented",
      "version": "1.0",
      "applicability": [
        "management",
        "client"
      ]
    },
    {
      "id": "DEMO-FW-01",
      "tags": [
        "management",
        "enforcement"
      ],
      "text": "Each cross-zone management session identifies its mediation or enforcement control by interface reference.",
      "exceptions": "Same zone management sessions are exempt.",
      "implementation": "implemented",
      "version": "1.0",
      "applicability": [
        "management",
        "enforcement"
      ]
    },
    {
      "id": "DEMO-NET-01",
      "tags": [
        "internet",
        "dependency"
      ],
      "text": "A no-internet system has no required internet hosted dependency.",
      "exceptions": "None in this demonstration.",
      "implementation": "implemented",
      "version": "1.0",
      "applicability": [
        "internet",
        "dependency"
      ]
    },
    {
      "id": "DEMO-IF-01",
      "tags": [
        "session",
        "protocol"
      ],
      "text": "Each network session identifies its initiator and protocol.",
      "exceptions": "None in this demonstration.",
      "implementation": "implemented",
      "version": "1.0",
      "applicability": [
        "session",
        "protocol"
      ]
    },
    {
      "id": "DEMO-HA-01",
      "tags": [
        "resilience",
        "availability"
      ],
      "text": "A resilience requirement has an explicit availability strategy.",
      "exceptions": "Systems without a resilience requirement are exempt.",
      "implementation": "implemented",
      "version": "1.0",
      "applicability": [
        "resilience",
        "availability"
      ]
    },
    {
      "id": "DEMO-AUD-01",
      "tags": [
        "management",
        "audit"
      ],
      "text": "Management functions identify an audit destination.",
      "exceptions": "None in this demonstration.",
      "implementation": "implemented",
      "version": "1.0",
      "applicability": [
        "management",
        "audit"
      ]
    },
    {
      "id": "DEMO-DAT-01",
      "tags": [
        "storage",
        "local"
      ],
      "text": "Local-only data is not assigned an external storage destination.",
      "exceptions": "None in this demonstration.",
      "implementation": "implemented",
      "version": "1.0",
      "applicability": [
        "storage",
        "local"
      ]
    },
    {
      "id": "DEMO-MAN-01",
      "tags": [
        "identity"
      ],
      "text": "Review identity lifecycle responsibilities with the owner.",
      "exceptions": "None specified.",
      "implementation": "manual_review",
      "version": "1.0",
      "applicability": [
        "identity"
